flowchart TB
  subgraph INPUT["1. Source and thought intake"]
    HUMAN["Human / model / environment input"]
    IMAGE["Source image / glyph / visual sequence"]
    SNAP["Immutable thought + image snapshot<br/>source · identity · version · hash"]
    HUMAN --> SNAP
    IMAGE --> SNAP
  end

  subgraph MAP["2. Thought mapping and Place"]
    DIST["Distinction + typed identity"]
    REL["Qualitative relations<br/>causal · structural · temporal · containment"]
    PLACE["Place / context<br/>observer B · substrate · protocol Π<br/>boundary κ · persistence ρ"]
    SPHERE["Five-sphere concept<br/>upper + lower limits; sphere 5 contains 1–4<br/>topology OPEN / NOT_YET_VERIFIED"]
    COG["Four cognitive maps<br/>logic · Book of Logic · semantic/word · letters/agents"]
    SNAP --> DIST --> REL --> PLACE
    SPHERE --> PLACE
    REL --> COG
  end

  subgraph LANG["3. Naming-first Thinking Language"]
    NAME["Name / type / source lineage"]
    AST["Typed thought graph / AST"]
    OPS["ROTATE · PROJECT · BRAID · READOUT"]
    NUM{"Identity + Place + unit + comparison<br/>+ persistence complete?"}
    RECEIPT["Measurement receipt<br/>value · uncertainty · protocol · source"]
    ABSTAIN["ABSTAIN / REVIEW / HALT"]
    NAME --> AST --> OPS --> NUM
    NUM -->|yes| RECEIPT
    NUM -->|no| ABSTAIN
  end

  subgraph VIS["4. Visual / imaginal transformation track"]
    CAP["Capture image + hash + region locator"]
    FIELD["Visual feature field<br/>shape · illumination · frequency representation"]
    TRANS["Versioned transform operator<br/>spatial / frequency / morphology / dispersion simulation"]
    CAND["Candidate glyph / form<br/>not yet canonical"]
    CHECK["Shape + language + Place + logic checks"]
    REVIEW["Human review + replay receipt"]
    CAP --> FIELD --> TRANS --> CAND --> CHECK --> REVIEW
  end

  subgraph LOGIC["5. Logic, semantic and fractal validation"]
    LNL["LNL parser / compiler"]
    KERNEL["Symbolic Logic Kernel"]
    FORMAL["Typed formal checks"]
    FRACTAL["Fractal composer"]
    PACKAGE["Bounded workload package<br/>invariants · lineage · tests · Place"]
    LNL --> KERNEL --> FORMAL --> FRACTAL --> PACKAGE
  end

  subgraph KRAKEN["6. KRAKEN execution fabric"]
    ADMIT["Workload admission<br/>capability · scope · safety"]
    ROUTER["Capability-aware scheduler"]
    CLASSICAL["CPU · GPU · FPGA · ASIC · DSP · NPU"]
    SIM["Simulation / emulation"]
    QPU["Physical QPU path<br/>NOT_YET_VERIFIED"]
    TELEMETRY["Execution receipt<br/>latency · throughput · utilization<br/>error · power · provenance"]
    ADMIT --> ROUTER
    ROUTER --> CLASSICAL
    ROUTER --> SIM
    ROUTER -.-> QPU
    CLASSICAL --> TELEMETRY
    SIM --> TELEMETRY
    QPU -.-> TELEMETRY
  end

  subgraph PRODUCT["7. Product and governance plane"]
    CABINET["Multi-model cabinet<br/>bounded tasks · handoffs · capability tiers"]
    API["Product API / SDK"]
    WORKBENCH["Logic Factory workbench<br/>maps · contracts · visual review"]
    KPI["Benchmark ledger<br/>baseline vs treatment"]
    VERIFY["Independent verification / replay"]
    RELEASE["Human approval + controlled release"]
    CABINET --> API --> WORKBENCH
    KPI --> VERIFY --> RELEASE
  end

  COG --> NAME
  REVIEW --> NAME
  RECEIPT --> LNL
  ABSTAIN --> VERIFY
  PACKAGE --> ADMIT
  PACKAGE --> CABINET
  TELEMETRY --> KPI
  REVIEW --> KPI
  RELEASE --> SNAP

