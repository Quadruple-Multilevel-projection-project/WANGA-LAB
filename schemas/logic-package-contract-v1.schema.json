{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WANGA Source-Grounded Logic Package Contract V1",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "version",
    "status",
    "formal_semantics",
    "premises",
    "conclusion",
    "source_refs",
    "tests",
    "known_limits",
    "semantic_status",
    "release_approval"
  ],
  "properties": {
    "schema_version": {
      "const": "wanga-logic-package/1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SPECIFIED",
        "PROTOTYPED",
        "TESTED",
        "VERIFIED",
        "INTERNAL_CANDIDATE_NOT_RELEASED"
      ]
    },
    "formal_semantics": {
      "type": "object",
      "required": [
        "logic_fragment",
        "variables",
        "supported_operators"
      ],
      "properties": {
        "logic_fragment": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "Bool",
              "Int",
              "Real",
              "String"
            ]
          }
        },
        "supported_operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "premises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "expr",
          "source_refs",
          "assumption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expr": {
            "$ref": "formal-fragment-v1.schema.json#/$defs/expression"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumption": {
            "type": "boolean",
            "default": false
          }
        },
        "anyOf": [
          {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "assumption": {
                "const": true
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "$ref": "formal-fragment-v1.schema.json#/$defs/expression"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "composition_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "semantic_status": {
      "enum": [
        "NOT_YET_VERIFIED",
        "VERIFIED_WITHIN_ENCODED_FRAGMENT"
      ]
    },
    "release_approval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "reviewer_id",
        "approved_at",
        "benchmark_report_sha256",
        "evidence_refs",
        "independent_review_pass"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_review_pass": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "semantic_status": {
                "const": "VERIFIED_WITHIN_ENCODED_FRAGMENT"
              }
            },
            "required": [
              "semantic_status"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          },
          "semantic_status": {
            "const": "VERIFIED_WITHIN_ENCODED_FRAGMENT"
          },
          "release_approval": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
