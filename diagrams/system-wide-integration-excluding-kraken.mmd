    DECISION{"All required gates pass?"}
    EVID --> DECISION
    CONTRA --> DECISION
    BENCH --> DECISION
    HUMAN --> DECISION
  end

  subgraph PRODUCTS["F. Products and external domains"]
    BOXES["Logic Boxes<br/>Evidence Gatekeeper · Scope Binder · Action Filter"]
