{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WANGA Bounded Typed Formal Fragment V1",
  "type": "object",
  "required": [
    "schema_version",
    "variables",
    "premises",
    "conclusion"
  ],
  "properties": {
    "schema_version": {
      "const": "wanga-formal-fragment/1.0"
    },
    "variables": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "enum": [
          "Bool",
          "Int",
          "Real",
          "String"
        ]
      }
    },
    "premises": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expr"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expr": {
            "$ref": "#/$defs/expression"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assumption": {
            "type": "boolean",
            "default": false
          }
        },
        "anyOf": [
          {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "assumption": {
                "const": true
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "$ref": "#/$defs/expression"
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "const"
          ],
          "properties": {
            "const": {
              "type": [
                "boolean",
                "integer",
                "number",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "not",
                "and",
                "or",
                "implies",
                "eq",
                "neq",
                "lt",
                "le",
                "gt",
                "ge",
                "add",
                "sub",
                "mul"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
