{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.local/schemas/plugin-configuration-v1.json",
  "title": "WANGA Plugin Configuration Package",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "name",
    "status",
    "components",
    "connections",
    "provenance",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "config_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "SOURCE_CHECKED",
        "SCHEMA_VALIDATED",
        "SECURITY_REVIEWED",
        "TESTED",
        "VERIFIED",
        "BLOCKED",
        "UNRESOLVED",
        "RETIRED"
      ]
    },
    "task_profile": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "logic_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term_id",
          "mapping_status"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "pattern": "^TERM-[0-9]{3}$"
          },
          "gate_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "source_location": {
            "type": "string"
          },
          "relation_type": {
            "type": "string"
          },
          "mapping_status": {
            "enum": [
              "PROPOSED",
              "SOURCE_BACKED",
              "VERIFIED",
              "UNRESOLVED",
              "REJECTED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "component_type",
          "version",
          "capabilities",
          "status"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "component_type": {
            "enum": [
              "PLUGIN",
              "MCP_SERVER",
              "MCP_TOOL",
              "AGENT_SKILL",
              "AGENT",
              "PROVIDER_ADAPTER",
              "RUNTIME",
              "DATA_STORE",
              "IDENTITY",
              "TRIGGER",
              "OTHER"
            ]
          },
          "version": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interface_ref": {
            "type": "string"
          },
          "input_schema_ref": {
            "type": "string"
          },
          "output_schema_ref": {
            "type": "string"
          },
          "auth_method": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives_or_fallbacks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "DISCOVERED",
              "SOURCE_CHECKED",
              "TESTED",
              "VERIFIED",
              "UNRESOLVED",
              "BLOCKED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "connection_id",
          "from_component",
          "to_component",
          "interface_type",
          "status"
        ],
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "from_component": {
            "type": "string"
          },
          "to_component": {
            "type": "string"
          },
          "interface_type": {
            "enum": [
              "MCP",
              "REST",
              "WEBHOOK",
              "EVENT",
              "SMTP",
              "IMAP",
              "SDK",
              "FILE",
              "INTERNAL",
              "OTHER"
            ]
          },
          "contract_ref": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "INBOUND",
              "OUTBOUND",
              "BIDIRECTIONAL"
            ]
          },
          "data_flow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permission_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PROPOSED",
              "SOURCE_BACKED",
              "COMPATIBILITY_TESTED",
              "VERIFIED",
              "BLOCKED",
              "UNRESOLVED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "subconfigurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "config_id",
          "version"
        ],
        "properties": {
          "config_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "approval_required_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_by_default": {
          "type": "boolean",
          "default": true
        },
        "secret_refs_only": {
          "type": "boolean",
          "default": true
        },
        "cycle_policy": {
          "enum": [
            "BLOCK",
            "BOUNDED_RECURSION_ONLY"
          ]
        },
        "data_retention": {
          "type": "string"
        },
        "human_review": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "portability": {
      "type": "object",
      "required": [
        "provider_dependencies",
        "export_formats",
        "status"
      ],
      "properties": {
        "provider_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives_or_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reproduction_steps_ref": {
          "type": "string"
        },
        "exit_test_ref": {
          "type": "string"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "ASSESSMENT",
            "HYPOTHESIS",
            "UNRESOLVED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "experiment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline_config_id": {
          "type": "string"
        },
        "measured_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_by",
        "created_at",
        "source_refs"
      ],
      "properties": {
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit_ref": {
          "type": "string"
        },
        "change_event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "schema_status",
        "security_status",
        "runtime_status"
      ],
      "properties": {
        "schema_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "security_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "BLOCKED"
          ]
        },
        "runtime_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_receipt_ref": {
          "type": "string"
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
