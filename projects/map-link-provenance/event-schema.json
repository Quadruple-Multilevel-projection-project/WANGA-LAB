{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/map-link-provenance/event.schema.json",
  "title": "Map Link Provenance Event",
  "type": "object",
  "required": ["transfer_id", "event_type", "event_sequence", "source", "destination", "timestamp", "contract_start_time", "action_id", "signature", "signature_status"],
  "properties": {
    "transfer_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["SOURCE_CREATED", "SOURCE_APPROVED", "DISPATCHED", "DESTINATION_RECEIVED", "DESTINATION_APPROVED", "DESTINATION_INGESTED", "ACK_RETURNED", "SOURCE_ACK_RECORDED"]},
    "event_sequence": {"type": "integer", "minimum": 1},
    "source": {"$ref": "#/$defs/endpoint"},
    "destination": {"$ref": "#/$defs/endpoint"},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "timestamp_source": {"type": "string"},
    "timestamp_status": {"enum": ["AUTHORITATIVE", "ASSISTANT_CAPTURE", "NOT_PROVIDED"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "contract_start_time": {"type": "string", "format": "date-time"},
    "action_id": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_status": {"enum": ["VALID", "BLOCKED_SIGNATURE"]},
    "previous_event_hash": {"type": ["string", "null"]},
    "source_event_hash": {"type": ["string", "null"]},
    "destination_receipt_hash": {"type": ["string", "null"]},
    "durable_record_id": {"type": ["string", "null"]},
    "evidence_locator": {"type": ["string", "null"]},
    "readback_status": {"enum": ["NOT_CHECKED", "MATCH", "MISMATCH", "BLOCKED"]}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["map_id"],
      "properties": {
        "map_id": {"type": "string", "minLength": 1},
        "map_version": {"type": ["string", "null"]},
        "node_id": {"type": ["string", "null"]},
        "edge_id": {"type": ["string", "null"]},
        "system": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
