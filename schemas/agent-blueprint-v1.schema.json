{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai231.example/schemas/agent-blueprint-v1.schema.json",
  "title": "AI231 Agent Blueprint v1",
  "description": "Canonical versioned specification for a digital agent created by the AI231 Meta-Agent Factory. It is not a recruitment record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "mission",
    "system_instructions",
    "capabilities",
    "tool_permissions",
    "input_contract",
    "output_contract",
    "boundaries",
    "acceptance_tests",
    "failure_behavior",
    "provenance",
    "system_requirements",
    "portability_contract"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "materialized",
        "tested",
        "active",
        "blocked",
        "deprecated"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 20
    },
    "system_instructions": {
      "type": "string",
      "minLength": 50
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "tool_permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "generate_text",
          "analyze_supplied_data",
          "read_public_web_content",
          "create_internal_task",
          "write_internal_report",
          "read_agent_registry"
        ]
      }
    },
    "input_contract": {
      "type": "object",
      "required": [
        "requirements"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output_contract": {
      "type": "object",
      "required": [
        "format",
        "required_fields"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_labels": {
          "type": "array",
          "items": {
            "enum": [
              "Verified",
              "Assessment",
              "Hypothesis",
              "Unresolved"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "failure_behavior": {
      "type": "string",
      "minLength": 20
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "when",
          "payload"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "payload": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_at",
        "created_by",
        "source_refs"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_commit": {
          "type": "string"
        },
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "isolation_required": {
          "const": true
        },
        "network_egress": {
          "const": false
        },
        "credential_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "system_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "portability_contract": {
      "type": "object",
      "required": [
        "provider_dependencies",
        "model_adapter_interface",
        "alternative_providers_or_fallback",
        "data_export_format",
        "owner_controlled_source_location",
        "deployment_reproduction_steps",
        "secrets_location_and_rotation",
        "exit_test",
        "portability_status"
      ],
      "properties": {
        "provider_dependencies": {
          "type": "string",
          "minLength": 1
        },
        "model_adapter_interface": {
          "type": "string",
          "minLength": 1
        },
        "alternative_providers_or_fallback": {
          "type": "string",
          "minLength": 1
        },
        "data_export_format": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_controlled_source_location": {
          "type": "string",
          "minLength": 1
        },
        "deployment_reproduction_steps": {
          "type": "string",
          "minLength": 1
        },
        "secrets_location_and_rotation": {
          "type": "string",
          "minLength": 1
        },
        "exit_test": {
          "type": "string",
          "minLength": 1
        },
        "exit_test_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "portability_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
