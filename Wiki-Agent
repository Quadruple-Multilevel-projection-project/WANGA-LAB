#!/usr/bin/env python3
import json
import re
import sys
from pathlib import Path
from datetime import datetime

URLS_FILE = Path("urls.txt")
RULES_FILE = Path("Rules.json")
LEXICON_FILE = Path("Lexicon.json")
ENTRIES_DIR = Path("Wiki_Entries")
ENTRIES_DIR.mkdir(exist_ok=True)

def load_json(path):
    if path.exists():
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def extract_from_text(text):
    words = re.findall(r"[\w׳״]+", text)
    names = list(set([w for w in words if len(w) > 2]))[:10]
    actions = list(set([w for w in words if w.endswith(("ל", "ה", "ים", "ות"))]))[:10]
    core = " ".join(words[:15])
    return {
        "Title": words[0] if words else "untitled",
        "Names": names,
        "Actions": actions,
        "Core_Inyan": core
    }

def run_verifier(data, source_text):
    from verify_math import verify
    return verify(data, source_text)

def save_entry(data):
    ts = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    fname = ENTRIES_DIR / f"entry_{ts}.md"
    content = f"""# {data.get('Title', 'untitled')}

## Names
{chr(10).join('- ' + n for n in data.get('Names', []))}

## Actions
{chr(10).join('- ' + a for a in data.get('Actions', []))}

## Core_Inyan
{data.get('Core_Inyan', '')}
"""
    with open(fname, "w", encoding="utf-8") as f:
        f.write(content)
    return fname

def main():
    if not URLS_FILE.exists():
        print("no urls.txt")
        sys.exit(1)
    urls = URLS_FILE.read_text(encoding="utf-8").strip().splitlines()
    for url in urls:
        source_text = ""
        attempts = 0
        while attempts < 3:
            data = extract_from_text(source_text or "רמבם")
            status, msg = run_verifier(data, source_text)
            if status == "ACCEPTED":
                path = save_entry(data)
                print(f"SAVED {path}")
                break
            else:
                attempts += 1
                print(f"REJECTED attempt {attempts}: {msg}")
        else:
            print("FAILED after 3 attempts")

if __name__ == "__main__":
    main()

