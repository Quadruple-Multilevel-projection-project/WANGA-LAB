#!/usr/bin/env python3
import json
from pathlib import Path
from collections import Counter

RULES_FILE = Path("Rules.json")
LOG_FILE = Path("rejection_log.txt")

def load_rules():
    if RULES_FILE.exists():
        with open(RULES_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def save_rules(rules):
    with open(RULES_FILE, "w", encoding="utf-8") as f:
        json.dump(rules, f, ensure_ascii=False, indent=2)

def main():
    if not LOG_FILE.exists():
        return
    lines = LOG_FILE.read_text(encoding="utf-8").splitlines()
    words = []
    for line in lines:
        if "פעולה לא מופיעה" in line or "מילה" in line:
            parts = line.split(":")
            if len(parts) > 1:
                words.append(parts[-1].strip())
    if not words:
        return
    cnt = Counter(words)
    rules = load_rules()
    banned = rules.get("Banned_Words", [])
    for w, c in cnt.most_common(5):
        if c >= 2 and w not in banned:
            banned.append(w)
    rules["Banned_Words"] = banned
    save_rules(rules)
    print("Rules updated")

if __name__ == "__main__":
    main()

