{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/signal.schema.json",
  "title": "Signal",
  "description": "Draft only. Replace the placeholder schema ID before publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "source_url",
    "timestamp",
    "operation",
    "content_hash",
    "status"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "SPECIFIED",
        "PROTOTYPED",
        "TESTED",
        "VERIFIED",
        "UNRESOLVED",
        "REQUIRES_REVIEW"
      ]
    },
    "source_sentence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
