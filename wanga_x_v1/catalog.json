  "computation_definitions": {
    "requirement_normalization": "Normalize the task objective, inputs, outputs, constraints and acceptance conditions.",
    "required_computation_mapping": "Derive explicit computation requirements from the normalized task and capability constraints.",
    "candidate_model_generation": "Generate candidate model representations from an explicit specification.",
    "natural_language_requirement_interpretation": "Interpret free-form language into a structured requirement; needs a configured language-model endpoint.",
    "logic_language_compilation": "Compile a formal logic-language program into a structured model representation.",
    "symbolic_inference": "Run deterministic inference over structured facts and declared rules.",
    "contradiction_detection": "Detect incompatible claims or constraints and route them for review.",
    "candidate_critique": "Critique architecture candidates against requirements, dependencies, evidence and safety contracts.",
    "goal_verification": "Check candidate outputs against declared acceptance conditions without upgrading an inference into truth.",
    "source_provenance": "Preserve source identifiers, versions, locations and traceable references.",
    "reversible_builds": "Create immutable construction frames, snapshots and auditable rollback branches.",
    "blueprint_materialization": "Emit a machine-readable architecture Blueprint and materialization plan.",
    "version_comparison": "Compare named source or architecture versions.",
    "structural_diff": "Detect changes in components, dependency edges, schemas and topology.",
    "semantic_diff": "Compare role and relation changes while preserving uncertainty.",
    "drift_classification": "Classify observed differences against a baseline; difference alone does not establish causality.",
    "neural_architecture_search": "Generate and rank candidate neural topologies under declared task and resource constraints.",
    "neural_runtime_materialization": "Instantiate or train an actual neural model through a verified runtime/backend; not implemented in this prototype."
  },
