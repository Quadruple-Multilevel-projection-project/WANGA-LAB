{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanga-lab.example/schemas/credential-coordination-v1.schema.json",
  "title": "Umbrella Credential Coordination Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_id",
    "status",
    "providers",
    "concurrency",
    "token_exchange",
    "policy",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "configuration_id": {
      "type": "string",
      "const": "UMBRELLA-CREDENTIAL-COORDINATION"
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED_NOT_CONNECTED",
        "PARTIALLY_CONNECTED",
        "VALIDATED"
      ]
    },
    "contract": {
      "type": "object"
    },
    "providers": {
      "type": "object",
      "required": [
        "git_credential_manager",
        "appdeploy_secret_vault",
        "github_chatgpt_connector"
      ]
    },
    "concurrency": {
      "type": "object",
      "required": [
        "local_gcm",
        "cloud_orchestrator",
        "critical_sections"
      ]
    },
    "token_exchange": {
      "type": "object",
      "required": [
        "protocol",
        "state",
        "enabled",
        "rules"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "default",
        "inheritance",
        "umbrella",
        "institute",
        "bodies",
        "oversight",
        "organizations",
        "agents"
      ]
    },
    "operations": {
      "type": "object"
    },
    "readiness": {
      "type": "object",
      "required": [
        "appdeploy_secret_configured",
        "cloud_distributed_lock_implemented",
        "github_api_roundtrip_tested",
        "status"
      ]
    }
  },
  "allOf": [
    {
      "properties": {
        "concurrency": {
          "properties": {
            "local_gcm": {
              "properties": {
                "scope": {
                  "const": "CurrentUser"
                },
                "supported_scopes": {
                  "const": [
                    "CurrentUser"
                  ]
                },
                "unsupported_scopes": {
                  "contains": {
                    "const": "Machine"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "token_exchange": {
          "properties": {
            "enabled": {
              "const": false
            }
          }
        }
      }
    },
    {
      "properties": {
        "policy": {
          "properties": {
            "oversight": {
              "properties": {
                "can_read_secret_values": {
                  "const": false
                },
                "can_write_credentials": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ]
}