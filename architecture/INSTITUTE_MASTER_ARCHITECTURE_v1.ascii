  LINK_RECORD:
    SOURCE_PLATFORM
    SOURCE_NODE_ID
    TARGET_PLATFORM
    TARGET_SITE_OR_FILE_ID
    TARGET_URL
    RELATION_TYPE
    EVIDENCE_REFERENCE
    LAST_VERIFIED_AT
    STATUS

  SYNC_POLICY:
    FIGMA_IS_VISUAL_ARCHITECTURE_INDEX
    WIX_IS_SITE_CONTENT_AND_PUBLICATION_SURFACE
    LINK_RECORD_IS_CROSS_PLATFORM_REFERENCE
    DO_NOT_INFER_LINKS_FROM_NAMES_ALONE
    DO_NOT_OVERWRITE_EXISTING_WIX_CONTENT

  |
  v

[AGENT OBSERVATION AND GOVERNANCE PLANE]
  OBSERVER_RUNS_ON_SEPARATE_PLATFORM
  OBSERVER_DOES_NOT_DIRECTLY_CONTACT_OR_CONTROL_TARGET_AGENT
  OBSERVER_READS_ONLY_AUTHORIZED_ARTIFACTS_AND_EXECUTION_EVIDENCE
  OBSERVER_INSPECTS:
    MAP_TO_AGENT_CONFIG_ALIGNMENT
    PRIME_RULE_COMPLIANCE
    SPECIALIZED_ALGORITHM_COMPLIANCE
    PRIME_FUNCTION_AND_SPECIALIZED_FUNCTION_BOUNDARIES
    TOOL_ROUTING_AND_PERMISSION_BOUNDARIES
    INPUT_OUTPUT_LINEAGE
    REPEAT_ACTIONS_AND_DUPLICATE_WORK
    DRIFT / ABSTENTION / ERROR / RECOVERY EVENTS
    EXECUTION_RECEIPTS_AND_PLATFORM_LOGS

  GOVERNANCE_OUTPUT:
    COMPLIANCE_RESULT
    EVIDENCE_LOCATORS
    VIOLATION_OR_GAP
    SEVERITY
    RECOMMENDED_CORRECTION
    HUMAN_ESCALATION
    AUDIT_TIMESTAMP

  IMPORTANT:
    OBSERVATION_IS_NOT_PROOF_UNLESS_EXECUTION_EVIDENCE_EXISTS
    NO_CREDENTIAL_EXTRACTION
    NO_CROSS_PLATFORM_SECRET_SHARING
    NO_UNAUTHORIZED_AGENT_CONTROL

  |
  v

[BRANCH OUTPUTS / FRUITS]
  RESEARCH_OUTPUT
  VERIFIED_LOGIC_COMPONENTS
  PLATFORM_AND_AGENT_MAPS
  REUSABLE_SPECIALIZED_FUNCTIONS
  PUBLIC_DOCUMENTATION
  ECONOMIC_AND_OPERATIONAL_COORDINATION
  HUMAN_AND_PUBLIC_BENEFIT

[FEEDBACK]
  OUTPUT_EVIDENCE -> OVERSIGHT -> LOGIC_ENGINE -> NEXT_CONFIGURATION
  EACH_BRANCH_MUST_DECLARE_ITS_OWN_BENEFIT_AND_ACCEPTANCE_TEST

[STATUS VOCABULARY]
  VERIFIED
  ASSESSMENT
  HYPOTHESIS
  NOT_YET_VERIFIED
  BLOCKED
  SPECIFIED_NOT_DEPLOYED

[NON-NEGOTIABLE INVARIANTS]
  THOUGHT != MATTER
  AI = RELATION(THOUGHT, MATTER)
  LANGUAGE_PROCESSOR != MEANING_PROCESSOR
  NO_UNDECLARED_WEIGHTS
  NO_UNSUPPORTED_SOURCE_LINEAGE
  NO_CLAIM_OF_DEPLOYMENT_WITHOUT_EXECUTION_EVIDENCE
  NO_REDUNDANT_RESTATEMENT_WHEN_NO_NEW_INFORMATION_EXISTS

[IMPLEMENTATION ORDER]
  1. REGISTER_PRIME_ALGORITHM_AND_PRIME_FUNCTIONS
  2. REGISTER_SPECIALIZED_ALGORITHMS_AND_FUNCTIONS_BY_BRANCH
  3. MAP_14_CHAPTERS_TO_EXECUTION_SEQUENCE
  4. MAP_175_TERMS_TO_FUNCTIONS_AND_SOURCE_REFERENCES
  5. REGISTER_GATES_AND_ACCEPTANCE_TESTS
  6. REGISTER_FIGMA_NODES_AND_WIX_SITE_LINKS
  7. CONNECT_READ_ONLY_OBSERVER_TO_AUTHORIZED_EXECUTION_EVIDENCE
  8. RUN_CONFORMANCE_TESTS
  9. ENABLE_STAGED_COORDINATION

[CURRENT LIMITS]
  FIGMA_FILE_CREATED; DESIGN_LAYER_BUILD_BLOCKED_BY_FIGMA_STARTER_MCP_LIMIT
  WIX_SITE_IDS_AND_SELECTED_URLS_READ_BACK; AI_DRIFT_FORENSICS_IS_DRAFT
  OBSERVER_PLUGIN_SPECIFIED; LIVE_AGENT_LOG_CONNECTORS_NOT_YET_CONFIGURED
  CONTRACT_VERIFICATION_NOT_RUN
