#!/usr/bin/env python3
import json
import sys
import re
from pathlib import Path

try:
    from sympy import *
except ImportError:
    pass

LEXICON_PATH = Path("Lexicon.json")
RULES_PATH = Path("Rules.json")

def load_json(path):
    if path.exists():
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def word_count(text):
    return len(re.findall(r"[\w׳״]+", text))

def check_contradictions(names, lexicon):
    for name in names:
        if name in lexicon and lexicon.get(name) == "סתירה":
            return False, f"סתירה במונח: {name}"
    return True, ""

def check_actions_in_source(actions, source_text):
    source_lower = source_text.lower()
    for action in actions:
        if action.lower() not in source_lower:
            return False, f"פעולה לא מופיעה במקור: {action}"
    return True, ""

def verify(data, source_text=""):
    rules = load_json(RULES_PATH)
    lexicon = load_json(LEXICON_PATH)
    
    names = data.get("Names", [])
    actions = data.get("Actions", [])
    core = data.get("Core_Inyan", "")
    
    if word_count(core) > rules.get("Core_Inyan_Max_Words", 15):
        return "REJECTED", f"Core_Inyan ארוך מ-{rules.get('Core_Inyan_Max_Words', 15)} מילים"
    
    ok, msg = check_contradictions(names, lexicon)
    if not ok:
        return "REJECTED", msg
    
    if source_text:
        ok, msg = check_actions_in_source(actions, source_text)
        if not ok:
            return "REJECTED", msg
    
    return "ACCEPTED", "OK"

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python verify_math.py <json_file> [source_text_file]")
        sys.exit(1)
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    source = ""
    if len(sys.argv) > 2:
        with open(sys.argv[2], "r", encoding="utf-8") as f:
            source = f.read()
    status, msg = verify(data, source)
    print(status)
    print(msg)
    sys.exit(0 if status == "ACCEPTED" else 1)

