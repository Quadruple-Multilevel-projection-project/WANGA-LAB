{
  "schema_version": "1.0.0",
  "configuration_id": "UMBRELLA-CREDENTIAL-COORDINATION",
  "status": "PREPARED_NOT_CONNECTED",
  "contract": {
    "purpose": "Coordinate credential acquisition and token use across local Git processes, cloud applications, organizations and agents without storing or exposing secrets in configuration or lock metadata.",
    "security_principles": [
      "least_privilege",
      "secrets_out_of_git",
      "no_secret_values_in_logs",
      "separate_local_and_cloud_credential_planes",
      "deny_by_default",
      "explicit_rotation",
      "human_approval_for_scope_expansion"
    ]
  },
  "providers": {
    "git_credential_manager": {
      "id": "GCM-LOCAL",
      "role": "local_git_credential_helper",
      "supported_hosts": [
        "github.com",
        "dev.azure.com",
        "bitbucket.org",
        "gitlab.com"
      ],
      "authentication": "interactive_or_cached_provider_authentication",
      "storage": "operating_system_credential_store",
      "runtime_scope": "local_user_session",
      "upstream_references": [
        {
          "pr": 2492,
          "title": "Add cross-platform locking primitives",
          "url": "https://github.com/git-ecosystem/git-credential-manager/pull/2492",
          "observed_state": "OPEN_NOT_MERGED_AS_OF_2026-11-20",
          "capability": "ILock_and_ILockFactory_current_user_file_lock",
          "integration_boundary": "locking foundation only; no provider authentication integration"
        },
        {
          "pr": 2500,
          "title": "oauth: support the token exchange grant",
          "url": "https://github.com/git-ecosystem/git-credential-manager/pull/2500",
          "observed_state": "OPEN_NOT_MERGED_AS_OF_2026-11-20",
          "capability": "RFC8693_OAuth_token_exchange",
          "integration_boundary": "OAuth client capability; not a distributed lock and not evidence of provider adoption"
        }
      ],
      "setup": {
        "credential_helper": "manager",
        "recommended_interaction": "browser_or_provider_native",
        "validation_command": "git ls-remote https://github.com/Quadruple-Multilevel-projection-project/WANGA-LAB.git",
        "forbidden_helpers": [
          "store"
        ],
        "never_print_credentials": true
      }
    },
    "appdeploy_secret_vault": {
      "id": "APPDEPLOY-SECRET-VAULT",
      "role": "cloud_backend_credential_store",
      "app_id": "logic-factory-hub-9jj4jw",
      "credential_refs": [
        {
          "name": "GITHUB_FINE_GRAINED_TOKEN",
          "provider": "GitHub",
          "purpose": "Hub-to-GitHub API access for WANGA-LAB only",
          "state": "MISSING_NOT_SUBMITTED",
          "scope": "single_repository",
          "permissions": [
            "metadata:read",
            "contents:read_write",
            "pull_requests:read_write"
          ],
          "forbidden_permissions": [
            "administration",
            "organization_owner",
            "workflow_write_unless_separately_approved"
          ]
        }
      ],
      "retrieval": "backend_only_secret_store_api",
      "frontend_visibility": "configured_boolean_and_scopes_only",
      "raw_secret_logging": false,
      "raw_secret_in_repository": false
    },
    "github_chatgpt_connector": {
      "id": "CHATGPT-GITHUB-CONNECTOR",
      "role": "interactive_repository_operations_from_chatgpt",
      "state": "CONNECTED_OUTSIDE_APPDEPLOY_BACKEND",
      "note": "This connector identity is separate from AppDeploy app secrets and local GCM credentials."
    }
  },
  "concurrency": {
    "local_gcm": {
      "implementation": "GCM_ILockFactory_file_backed_current_user_lock",
      "availability": "UPSTREAM_PR_NOT_MERGED",
      "scope": "CurrentUser",
      "ownership": "exclusive_open_file_handle_not_pid_or_pathname",
      "lock_key_template": "gcm-auth-v1-{provider}-{host}-{account-fingerprint}-{operation}",
      "name_constraints": "single filename component; never include token, password, private key or raw email",
      "acquisition": {
        "mode": [
          "try_nowait",
          "finite_timeout",
          "wait_with_cancellation"
        ],
        "recommended_timeout_seconds": 10,
        "cancellation": true,
        "retry_jitter": true
      },
      "release": "dispose_or_explicit_release_even_after_exception",
      "diagnostics": {
        "inspect_orphaned_or_corrupt_metadata": true,
        "automatic_deletion": false,
        "include_process_id_in_trace": true
      },
      "supported_scopes": [
        "CurrentUser"
      ],
      "unsupported_scopes": [
        "Process",
        "Machine",
        "CrossMachine"
      ]
    },
    "cloud_orchestrator": {
      "implementation": "DISTRIBUTED_LEASE_ADAPTER_REQUIRED",
      "state": "NOT_IMPLEMENTED",
      "required_primitives": [
        "atomic_lease_acquisition",
        "lease_expiry",
        "renewal",
        "fencing_token",
        "cancellation",
        "bounded_wait",
        "audit_record"
      ],
      "accepted_backends": [
        "transactional_database_with_atomic_compare_and_swap",
        "redis_with_atomic_lease_and_fencing"
      ],
      "prohibited_substitution": "Do not use a local file lock as a cross-instance or cross-machine lock in AppDeploy/serverless workers.",
      "lock_key_template": "cloud-credential-v1:{provider}:{tenant-id}:{account-fingerprint}:{operation}",
      "default_timeout_seconds": 10,
      "retry": "bounded_exponential_backoff_with_jitter"
    },
    "critical_sections": [
      "interactive_authentication",
      "refresh_token_rotation",
      "oauth_token_exchange",
      "installation_token_minting"
    ],
    "non_critical_sections_not_locked": [
      "ordinary_git_fetch_after_valid_token",
      "read_only_file_parse",
      "diagram_render"
    ]
  },
  "token_exchange": {
    "protocol": "OAuth 2.0 Token Exchange (RFC 8693)",
    "upstream_gcm_pr": 2500,
    "state": "WAIT_FOR_UPSTREAM_MERGE_AND_PROVIDER_SUPPORT",
    "enabled": false,
    "rules": [
      "subject_token_is_never_logged",
      "subject_token_is_not_written_to_lock_metadata",
      "requested_scopes_must_be_subset_of_agent_policy",
      "audience_and_issued_token_type_must_be_explicit",
      "exchange_result_is_short_lived_and_task_scoped"
    ]
  },
  "policy": {
    "default": "DENY",
    "inheritance": "deny_overrides_allow; child_levels_may_narrow_only",
    "umbrella": {
      "allowed": [
        "read_public_repository_metadata"
      ],
      "denied": [
        "unscoped_secret_read",
        "unreviewed_write",
        "organization_admin"
      ]
    },
    "institute": {
      "allowed": [
        "issue_scoped_short_lived_tokens",
        "review_credential_status"
      ],
      "denied": [
        "read_raw_secret_values",
        "reuse_agent_token_across_tenants"
      ]
    },
    "bodies": {
      "DEEP-NETWORK-ANALYTICS": {
        "allowed": [
          "read_repository",
          "read_sources",
          "write_analysis_artifacts_to_approved_branch"
        ],
        "denied": [
          "change_credential_policy",
          "administer_secrets"
        ]
      },
      "DEEP-NETWORK-LOGISTICS": {
        "allowed": [
          "orchestrate_approved_git_operations",
          "request_task_scoped_token"
        ],
        "denied": [
          "approve_own_scope_expansion",
          "read_private_key_material"
        ]
      },
      "DEEP-NETWORK-ALGORITHMS": {
        "allowed": [
          "propose_credential_policy",
          "validate_configuration",
          "create_versioned_policy_changes"
        ],
        "denied": [
          "bypass_approval_gate",
          "read_raw_secret_values"
        ]
      }
    },
    "oversight": {
      "id": "OR",
      "access": "read_only_audit_and_hold_recommendation",
      "can_read_secret_values": false,
      "can_write_credentials": false
    },
    "organizations": {
      "default": "no_inherited_credentials; explicit per-organization grant required"
    },
    "agents": {
      "default": "no_persistent_personal_token",
      "credential_lifetime": "one_task_or_short_lived_provider_token",
      "scope": "repository_and_operation_bound",
      "secret_reference_only": true
    }
  },
  "operations": {
    "rotation": "manual_approval_and_versioned_rollout",
    "revocation": "revoke_upstream_then_remove_app_secret_reference",
    "audit_fields": [
      "timestamp",
      "contract_start_time",
      "action_id",
      "sha256",
      "actor_id",
      "provider",
      "credential_reference",
      "scope",
      "result_code"
    ],
    "audit_must_not_include": [
      "secret_value",
      "access_token",
      "refresh_token",
      "private_key",
      "authorization_header"
    ],
    "rollback": "restore_previous_non-secret_policy_version; never restore revoked token material"
  },
  "readiness": {
    "local_gcm_installed": "NOT_CHECKED_ON_USER_WORKSTATION",
    "upstream_lock_pr_merged": false,
    "upstream_token_exchange_pr_merged": false,
    "appdeploy_secret_configured": false,
    "cloud_distributed_lock_implemented": false,
    "github_api_roundtrip_tested": false,
    "status": "PREPARED_NOT_CONNECTED"
  }
}