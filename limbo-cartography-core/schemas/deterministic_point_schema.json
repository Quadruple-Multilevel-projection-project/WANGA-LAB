{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeterministicCollapsePoint",
  "type": "object",
  "properties": {
    "coordinate_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["OBSERVED", "STRUCTURALLY_TESTED", "VERIFIED"]},
    "legacy_system_status": {"type": "string", "enum": ["NOT_ASSESSED", "LOCAL_STRUCTURE_FAILURE", "COLLAPSE_REPORTED"]},
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "context": {"type": "string", "minLength": 1},
    "failure_observation": {"type": "string", "minLength": 1},
    "structure_ref": {"type": ["string", "null"]},
    "verification": {
      "type": "object",
      "properties": {
        "procedure": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "verified_at_utc": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "required": ["procedure", "result", "verified_at_utc", "evidence_refs"],
      "additionalProperties": false
    }
  },
  "required": ["coordinate_id", "timestamp_utc", "status", "legacy_system_status", "source_refs", "context", "failure_observation"],
  "allOf": [{
    "if": {"properties": {"status": {"const": "VERIFIED"}}, "required": ["status"]},
    "then": {"required": ["verification"]}
  }],
  "additionalProperties": false
}
