flowchart TD
  SRC["L0 Source / exact span / explicit assumption"] --> TERM["S1 Core term / primitive"]
  TERM --> DEF["S2 Immediate definition / typed attributes"]
  DEF --> UP["S3 Upper boundary / declared axis"]
  UP --> LOW["S4 Lower boundary / declared axis"]
  LOW --> PLACE["S5 Enclosing semantic place — contains S1–S4"]

  subgraph SEM["Semantic Space Contract — every canonical word"]
    TERM
    DEF
    UP
    LOW
    PLACE
    REL["Typed relations / neighboring terms"]
    TRUTH["Truth conditions + positive / negative / boundary tests"]
    COUNTER["Counterexamples + contradiction keys"]
    REG["Versioned semantic registry / provenance"]
    REL --> PLACE
    PLACE --> TRUTH
    TRUTH --> COUNTER
    REG --> TERM
    REG --> REL
  end

  SRC --> REG
  PLACE --> FRAG["L1 Typed fragment"]
  FRAG --> COMP["L2 Recursive composition candidate"]
  COMP --> MODEL["L3 Versioned model candidate"]

  subgraph CONSTITUTION["Constitutional invariants — apply at every level"]
    I1["CF-01 Source before conclusion"]
    I2["CF-02 Preserve epistemic status"]
    I3["CF-03 Type every relation"]
    I4["CF-04 Preserve types and scope"]
    I5["CF-05 No silent premises/rules"]
    I6["CF-06 Provenance and deterministic record"]
    I7["CF-07 Bounded recursion"]
    I8["CF-08 Preserve contradictions"]
    I9["CF-09 No statistical shortcut"]
    I10["CF-10 Fail closed: REVIEW / ABSTAIN / HALT"]
    TAIL["CF-11 NO SEMANTIC TAILS — no unversioned alias, extension, scope drift or incompatible definition"]
  end

  TERM -.-> CONSTITUTION
  DEF -.-> CONSTITUTION
  UP -.-> CONSTITUTION
  LOW -.-> CONSTITUTION
  PLACE -.-> CONSTITUTION
  MODEL -.-> CONSTITUTION

  MODEL --> SUITES["Semantic suites: positive / negative / boundary"]
  SUITES --> HOLD["Holdout + counterexamples + independent review"]
  HOLD --> GATE{"Semantic contract gate"}
  GATE -->|All declared conditions pass| READY["VERIFIED only for declared scope"]
  GATE -->|Missing definition / stale registry| REVIEW["NOT_YET_VERIFIED / REVIEW"]
  GATE -->|Contradictory tail or boundary collision| CONFLICT["Quarantine both branches / OPEN CONFLICT"]
  CONFLICT --> ADJ["Versioned adjudication + required tests"]
  ADJ --> GATE
  REVIEW --> LOG["Append-only report / source / commit / test receipt"]
  READY --> LOG
  LOG --> DAILY["Daily registry snapshot + derived diagrams"]
  DAILY --> REG

  classDef source fill:#dbeafe,stroke:#2563eb,color:#172554
  classDef candidate fill:#fef3c7,stroke:#d97706,color:#78350f
  classDef verified fill:#dcfce7,stroke:#16a34a,color:#14532d
  classDef stop fill:#ffe4e6,stroke:#e11d48,color:#881337
  class SRC,REG source
  class TERM,DEF,UP,LOW,PLACE,REL,TRUTH,COUNTER,FRAG,COMP,MODEL,SUITES,HOLD candidate
  class READY verified
  class REVIEW,CONFLICT,TAIL stop
