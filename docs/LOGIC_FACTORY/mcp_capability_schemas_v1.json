{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quadruple-Multilevel-projection-project/WANGA-LAB/blob/main/docs/LOGIC_FACTORY/mcp_capability_schemas_v1.json",
  "title": "WANGA MCP Capability and Action Coordinate Schemas",
  "type": "object",
  "required": [
    "schema_version",
    "providers",
    "resources",
    "capabilities",
    "capability_clusters",
    "action_coordinates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "capability_clusters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityCluster"
      }
    },
    "action_coordinates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionCoordinate"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source_uri",
        "locator_type",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_ref": {
          "type": "string"
        },
        "locator_type": {
          "enum": [
            "tool_declaration",
            "server_metadata",
            "skill_file",
            "api_documentation",
            "runtime_log",
            "test_result",
            "repository_file",
            "manual_observation"
          ]
        },
        "locator": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "provider_id",
        "name",
        "surface_type",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "surface_type": {
          "enum": [
            "MCP_SERVER",
            "CHATGPT_CONNECTOR",
            "PLUGIN",
            "LOCAL_TOOL_SERVER",
            "API_PROVIDER",
            "SKILL_PACK",
            "OTHER"
          ]
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "client": {
          "type": "string"
        },
        "connection_scope": {
          "enum": [
            "SESSION",
            "USER",
            "WORKSPACE",
            "PROJECT",
            "MACHINE",
            "UNKNOWN"
          ]
        },
        "auth_state": {
          "enum": [
            "AUTHENTICATED",
            "NEEDS_AUTH",
            "NOT_CONFIGURED",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "FOUND",
            "FOUND_ADJACENT",
            "NOT_FOUND_IN_SEARCH",
            "UNDETERMINED",
            "VERIFIED",
            "HYPOTHETICAL",
            "BLOCKED"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "resource_id",
        "provider_id",
        "resource_type",
        "name",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "MCP_SERVER",
            "CONNECTOR_SURFACE",
            "TOOL",
            "SKILL",
            "APP",
            "DATA_RESOURCE",
            "CLIENT",
            "AUTH_CONTEXT"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "client": {
          "type": "string"
        },
        "connection_scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "FOUND",
            "FOUND_ADJACENT",
            "NOT_FOUND_IN_SEARCH",
            "UNDETERMINED",
            "VERIFIED",
            "HYPOTHETICAL",
            "BLOCKED"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "capability_id",
        "provider_id",
        "resource_id",
        "name",
        "operation_class",
        "input_schema",
        "output_schema",
        "side_effect",
        "approval_required",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "operation_class": {
          "enum": [
            "READ",
            "SEARCH",
            "CREATE",
            "UPDATE",
            "DELETE",
            "EXECUTE",
            "DEPLOY",
            "VERIFY"
          ]
        },
        "input_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "output_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "compatibility_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "side_effect": {
          "enum": [
            "NONE",
            "READ_ONLY",
            "REVERSIBLE_WRITE",
            "IRREVERSIBLE_WRITE",
            "EXTERNAL_ACTION",
            "UNKNOWN"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "reversible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "FOUND",
            "FOUND_ADJACENT",
            "NOT_FOUND_IN_SEARCH",
            "UNDETERMINED",
            "VERIFIED",
            "HYPOTHETICAL",
            "BLOCKED"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "capabilityCluster": {
      "type": "object",
      "required": [
        "capability_cluster_id",
        "user_outcome",
        "capability_ids",
        "composition_graph",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_cluster_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "user_outcome": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "composition_graph": {
          "type": "object"
        },
        "schema_compatibility": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        },
        "permission_review": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        },
        "duplicate_review": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        },
        "status": {
          "enum": [
            "PROPOSED",
            "TESTED",
            "VERIFIED",
            "BLOCKED",
            "REJECTED"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "actionCoordinate": {
      "type": "object",
      "required": [
        "action_coordinate_id",
        "capability_cluster_id",
        "ordered_capability_ids",
        "execution_graph",
        "preconditions",
        "postconditions",
        "approval_gate",
        "idempotency_policy",
        "timeout_retry_policy",
        "compensation_policy",
        "verification_plan",
        "status",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "action_coordinate_id": {
          "type": "string"
        },
        "capability_cluster_id": {
          "type": "string"
        },
        "ordered_capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "execution_graph": {
          "type": "object"
        },
        "input_contract": {
          "type": "object"
        },
        "output_contract": {
          "type": "object"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth_context_ref": {
          "type": "string"
        },
        "permission_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_gate": {
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED_READ_ONLY",
            "UNRESOLVED"
          ]
        },
        "idempotency_policy": {
          "type": "string"
        },
        "timeout_retry_policy": {
          "type": "string"
        },
        "compensation_policy": {
          "type": "string"
        },
        "evidence_locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "app_ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "change_event_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "PLANNED",
            "BLOCKED",
            "EXECUTED",
            "VERIFIED",
            "FAILED",
            "ABSTAINED"
          ]
        }
      }
    }
  }
}